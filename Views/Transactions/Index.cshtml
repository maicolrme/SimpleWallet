@model IReadOnlyList<Transaction>
@{
    ViewData["Title"] = "Transactions";
    var filter = (string)(ViewBag.Filter ?? "all");
}

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
        <h1 class="text-xl font-semibold">@Loc["Transactions"]</h1>
        <p class="text-sm text-muted">@Loc["All movements of your wallet."]</p>
    </div>

    <div class="flex items-center gap-1 bg-white border border-gray-100 rounded-lg p-1">
        <a asp-action="Index" asp-route-filter="all"
           class="px-3 py-1.5 rounded-md text-sm transition @(filter == "all" ? "bg-brand text-white font-medium" : "text-muted hover:text-ink")">
            @Loc["All"]
        </a>
        <a asp-action="Index" asp-route-filter="received"
           class="px-3 py-1.5 rounded-md text-sm transition @(filter == "received" ? "bg-brand text-white font-medium" : "text-muted hover:text-ink")">
            @Loc["Received"]
        </a>
        <a asp-action="Index" asp-route-filter="sent"
           class="px-3 py-1.5 rounded-md text-sm transition @(filter == "sent" ? "bg-brand text-white font-medium" : "text-muted hover:text-ink")">
            @Loc["Sent"]
        </a>
    </div>
</div>

<div class="bg-white border border-gray-100 rounded-xl shadow-sm">
    @if (Model.Count == 0)
    {
        <div class="px-6 py-10 text-sm text-muted text-center">
            @Loc["No transactions in this view."]
        </div>
    }
    else
    {
        <div class="overflow-x-auto px-6 py-2">
            <table class="w-full">
                <thead>
                    <tr class="text-left text-xs text-muted">
                        <th class="py-3 pr-4 font-medium">@Loc["Date"]</th>
                        <th class="py-3 pr-4 font-medium">@Loc["Description"]</th>
                        <th class="py-3 pr-4 font-medium">@Loc["Type"]</th>
                        <th class="py-3 text-right font-medium">@Loc["Amount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model)
                    {
                        <partial name="_TransactionRow" model="transaction" />
                    }
                </tbody>
            </table>
        </div>
    }
</div>
