@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-lg mx-auto py-16 text-center">
    <div class="w-12 h-12 mx-auto rounded-full bg-red-50 text-red-600 flex items-center justify-center text-xl font-semibold">!</div>
    <h1 class="mt-5 text-xl font-semibold">@Loc["Something went wrong"]</h1>
    <p class="mt-2 text-sm text-muted">@Loc["An error occurred while processing your request."]</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-muted">
            @Loc["Request ID"]: <code>@Model.RequestId</code>
        </p>
    }

    <a href="/" class="inline-block mt-6 px-4 py-2 rounded-lg bg-brand hover:bg-brand-dark text-white text-sm font-medium transition">
        @Loc["Back home"]
    </a>
</div>
