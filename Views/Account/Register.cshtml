@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<div class="max-w-md mx-auto py-8">
    <div class="bg-white border border-gray-100 rounded-xl p-6 sm:p-8 shadow-sm">
        <h1 class="text-xl font-semibold">@Loc["Create account"]</h1>
        <p class="mt-1 text-sm text-muted">@Loc["Your wallet is created automatically."]</p>

        <form asp-controller="Account" asp-action="Register" method="post" class="mt-6 space-y-4" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium mb-1"></label>
                    <input asp-for="FirstName" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
                    <span asp-validation-for="FirstName" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium mb-1"></label>
                    <input asp-for="LastName" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
                    <span asp-validation-for="LastName" class="text-xs text-red-600"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Email" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium mb-1"></label>
                <input asp-for="Password" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" placeholder="@Loc["At least 8 characters"]" />
                <span asp-validation-for="Password" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium mb-1"></label>
                <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
            </div>

            <button type="submit"
                    class="w-full px-4 py-2.5 rounded-lg bg-brand hover:bg-brand-dark text-white font-medium transition">
                @Loc["Create account"]
            </button>
        </form>

        <p class="mt-5 text-sm text-muted text-center">
            @Loc["Already registered?"]
            <a asp-controller="Account" asp-action="Login" class="text-brand-dark font-medium">@Loc["Sign in"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
