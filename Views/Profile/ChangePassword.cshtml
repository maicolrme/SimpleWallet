@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="max-w-lg">
    <a asp-action="Index" class="text-sm text-muted hover:text-ink">&larr; @Loc["Back to profile"]</a>

    <div class="mt-4 bg-white border border-gray-100 rounded-xl p-6 shadow-sm">
        <h1 class="text-xl font-semibold">@Loc["Change password"]</h1>

        <form asp-action="ChangePassword" method="post" class="mt-6 space-y-4" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

            <div>
                <label for="CurrentPassword" class="block text-sm font-medium mb-1">@Loc["Current password"]</label>
                <input asp-for="CurrentPassword" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
                <span asp-validation-for="CurrentPassword" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label for="NewPassword" class="block text-sm font-medium mb-1">@Loc["New password"]</label>
                <input asp-for="NewPassword" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" placeholder="@Loc["At least 8 characters"]" />
                <span asp-validation-for="NewPassword" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label for="ConfirmPassword" class="block text-sm font-medium mb-1">@Loc["Confirm new password"]</label>
                <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-gray-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand/40 focus:border-brand" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
            </div>

            <button type="submit"
                    class="px-4 py-2 rounded-lg bg-brand hover:bg-brand-dark text-white text-sm font-medium transition">
                @Loc["Change password"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
