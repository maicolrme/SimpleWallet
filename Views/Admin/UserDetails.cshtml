@model User
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User details";
}

<div class="mb-6">
    <h1 class="text-xl font-semibold">@Model.FullName</h1>
    <p class="text-sm text-muted">@Model.Email</p>
</div>

<div class="grid lg:grid-cols-3 gap-4">
    <div class="bg-white border border-gray-100 rounded-xl p-6 shadow-sm">
        <h2 class="text-sm font-semibold">@Loc["Account"]</h2>
        <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between">
                <dt class="text-muted">@Loc["Role"]</dt>
                <dd class="font-medium">@Model.Role</dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-muted">@Loc["Status"]</dt>
                <dd>
                    <span class="text-xs px-2 py-1 rounded-full @(Model.IsActive ? "bg-brand-soft text-brand-dark" : "bg-red-50 text-red-600")">
                        @(Model.IsActive ? Loc["Active"] : Loc["Inactive"])
                    </span>
                </dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-muted">@Loc["Created"]</dt>
                <dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
            </div>
        </dl>

        <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post" class="mt-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="isActive" value="@(!Model.IsActive)" />
            <button type="submit"
                    class="w-full px-3 py-2 rounded-lg border border-gray-200 hover:bg-surface text-sm font-medium transition">
                @(Model.IsActive ? Loc["Deactivate user"] : Loc["Activate user"])
            </button>
        </form>
    </div>

    <div class="bg-white border border-gray-100 rounded-xl p-6 shadow-sm">
        <h2 class="text-sm font-semibold">@Loc["Role"]</h2>
        <form asp-action="SetRole" asp-route-id="@Model.Id" method="post" class="mt-4 space-y-3">
            @Html.AntiForgeryToken()
            <select name="role"
                    class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand/40">
                <option value="User" selected="@(Model.Role == "User" ? "selected" : null)">User</option>
                <option value="Admin" selected="@(Model.Role == "Admin" ? "selected" : null)">Admin</option>
            </select>
            <button type="submit"
                    class="w-full px-3 py-2 rounded-lg bg-brand hover:bg-brand-dark text-white text-sm font-medium transition">
                @Loc["Update role"]
            </button>
        </form>
    </div>

    <div class="bg-white border border-gray-100 rounded-xl p-6 shadow-sm">
        <h2 class="text-sm font-semibold">@Loc["Wallet"]</h2>
        @if (Model.Wallet is not null)
        {
            <div class="mt-4 text-3xl font-semibold">€@Model.Wallet.Balance.ToString("N2")</div>
            <div class="mt-1 text-xs text-muted">@Model.Wallet.Currency</div>
            <div class="mt-4 rounded-lg bg-surface border border-gray-100 p-3">
                <div class="text-xs text-muted">@Loc["Address"]</div>
                <code class="text-sm">@Model.Wallet.Address</code>
            </div>
            <div class="mt-3 text-xs text-muted">@Loc["Created"] @Model.Wallet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
        }
        else
        {
            <p class="mt-3 text-sm text-muted">@Loc["No wallet."]</p>
        }
    </div>
</div>
